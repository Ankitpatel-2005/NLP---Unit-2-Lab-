{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1Owp14bBIAXpXXcboJu6jbie5WneI8KQW","timestamp":1793211112654}],"authorship_tag":"ABX9TyPcEMP07bJ/vgrIWqo88CRO"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["\n","import tensorflow as tf\n","from tensorflow.keras.datasets import imdb\n","from tensorflow.keras.preprocessing.sequence import pad_sequences\n","from tensorflow.keras.models import Sequential\n","from tensorflow.keras.layers import Embedding, SimpleRNN, LSTM, Dense\n","\n","vocab_size = 10000\n","max_length = 200\n","\n","(x_train, y_train), (x_test, y_test) = imdb.load_data(\n","    num_words=vocab_size\n",")\n","\n","x_train = pad_sequences(x_train, maxlen=max_length)\n","x_test = pad_sequences(x_test, maxlen=max_length)\n","\n","def build_model(model_type):\n","    model = Sequential([\n","        Embedding(vocab_size, 32),\n","        model_type(32),\n","        Dense(1, activation=\"sigmoid\")\n","    ])\n","    model.compile(\n","        optimizer=\"adam\",\n","        loss=\"binary_crossentropy\",\n","        metrics=[\"accuracy\"]\n","    )\n","    return model\n","\n","rnn_model = build_model(SimpleRNN)\n","rnn_model.fit(\n","    x_train, y_train,\n","    epochs=3,\n","    batch_size=64,\n","    validation_split=0.2\n",")\n","\n","rnn_loss, rnn_accuracy = rnn_model.evaluate(x_test, y_test)\n","print(\"RNN Accuracy:\", rnn_accuracy)\n","\n","lstm_model = build_model(LSTM)\n","lstm_model.fit(\n","    x_train, y_train,\n","    epochs=3,\n","    batch_size=64,\n","    validation_split=0.2\n",")\n","\n","lstm_loss, lstm_accuracy = lstm_model.evaluate(x_test, y_test)\n","print(\"LSTM Accuracy:\", lstm_accuracy)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"PnfiTnPrroDh","executionInfo":{"status":"ok","timestamp":1793211062215,"user_tz":-330,"elapsed":209263,"user":{"displayName":"Ankit Patel","userId":"03542382968557